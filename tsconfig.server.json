{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "server",
    "tests",
    "shared"
  ]
}
