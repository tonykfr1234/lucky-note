{
  "name": "lucky-note",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "抽獎NOTE / LuckyNote — private and shared notebooks, canvas, lists and expense splitting",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=8"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src shared server tests scripts vite.config.ts playwright.config.ts",
    "test": "npm run build:server && node scripts/test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "licenses": "node scripts/licenses.mjs",
    "package": "python scripts/package-release.py",
    "build:local": "vite build --mode device && node scripts/write-local-marker.mjs dist-local",
    "build:preview": "vite build --mode preview && node scripts/write-local-marker.mjs dist-preview",
    "preview:local": "node scripts/local-preview-server.mjs dist-local",
    "preview:web": "node scripts/local-preview-server.mjs dist-preview",
    "test:local": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "lib0": "0.2.119",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
}
