{
  "name": "lucky-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "抽獎NOTE / LuckyNote — private and shared notebooks, canvas, lists and expense splitting",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src server tests scripts vite.config.ts playwright.config.ts",
    "test": "npm run build:server && node scripts/test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "licenses": "node scripts/licenses.mjs",
    "package": "python scripts/package-release.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
}
