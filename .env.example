# Local development only. Never commit .env or real credentials.
HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
APP_ORIGIN=http://127.0.0.1:4317
AUTH_MODE=local
NODE_ENV=development

# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain (no trailing slash)
# SESSION_SECRET must be a fresh random value of at least 32 characters.
# Prefer AUTH_MODE=google. Password auth in production requires ALLOW_LOCAL_AUTH=true.
SESSION_SECRET=
ALLOW_LOCAL_AUTH=false
ALLOW_NETWORK=false

# Google sign-in only: openid email profile; no automatic Drive/Gmail grant.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Explicitly configured server-side integrations, never VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=1024
OPENAI_MAX_REQUEST_TOKENS=12000
OPENAI_DAILY_TOKEN_LIMIT=20000
LINE_CHANNEL_ACCESS_TOKEN=

# Each exact workspace UUID maps to its own authorized binding.
# Example shape only (no real credentials):
# {"workspace-uuid":{"googleRefreshToken":"...","driveFolderId":"...","calendarId":"...","gmailFrom":"...","lineRecipientId":"...","quietHours":{"start":22,"end":8,"timeZone":"Asia/Taipei"}}}
# Use a deployment secret store for these values. Credentials are not stored in SQLite.
WORKSPACE_INTEGRATIONS_JSON={}
